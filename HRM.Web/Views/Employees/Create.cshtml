@model HRM.Application.DTOs.Employees.CreateEmployeeRequest

@{
    ViewData["Title"] = "Create Employee";
}

<div class="container-fluid">

    <div class="mb-4">
        <h1 class="h3 mb-1">Create Employee</h1>
        <p class="text-muted mb-0">
            Add a new employee to the HRM system.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="EmployeeNumber"
                               class="form-label">
                            Employee Number
                        </label>

                        <input asp-for="EmployeeNumber"
                               class="form-control"
                               placeholder="EMP001" />

                        <span asp-validation-for="EmployeeNumber"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="HireDate"
                               class="form-label">
                            Hire Date
                        </label>

                        <input asp-for="HireDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="HireDate"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName"
                               class="form-label">
                            First Name
                        </label>

                        <input asp-for="FirstName"
                               class="form-control"
                               placeholder="Rendy" />

                        <span asp-validation-for="FirstName"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName"
                               class="form-label">
                            Last Name
                        </label>

                        <input asp-for="LastName"
                               class="form-control"
                               placeholder="Aldo" />

                        <span asp-validation-for="LastName"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="Email"
                               class="form-label">
                            Email
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="employee@company.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <div class="d-flex gap-2 mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Employee
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}